# =============================================================
# VARIÁVEIS DE AMBIENTE — MODELO (SEM SEGREDOS)
# =============================================================
# Somente a URL e a chave publicável podem existir no navegador.
# Tokens de provedores ficam exclusivamente nos Secrets das Edge Functions.

# Backend (Supabase)
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade temporária com projetos que usam a chave anon legada:
# VITE_PUBLIC_SUPABASE_ANON_KEY=

# Edge Functions / Secrets do Supabase (não usar no frontend)
# OPENAI_API_KEY=
# OPENAI_PROMPT_MODEL=gpt-4.1-mini
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
# A Ana usa OpenAI como principal e Claude como alternativa segura quando a OpenAI
# não estiver configurada ou tiver indisponibilidade temporária. Nunca exponha essas chaves no navegador.
# ALLOWED_ORIGIN=https://leadai-crm-preview.fabricio926564.chatgpt.site
# AUTOMATION_WORKER_KEY=

# Integrações de canais (configurar somente quando o respectivo canal for ativado)
# RESEND_API_KEY=
# RESEND_FROM_DOMAIN=

# Evolution GO (configuração de cada instância fica no cofre, pela tela Canais)
# Libere somente origens HTTPS públicas e controladas; nunca use IP privado, localhost ou curingas.
# EVOLUTION_GO_ALLOWED_ORIGINS=https://evolution.suaempresa.com
