# =============================================================
#  VARIÁVEIS DE AMBIENTE — MODELO (SEM SEGREDOS)
# -------------------------------------------------------------
#  Este arquivo não contém tokens, senhas ou chaves reais.
#  Copie para ".env" no ambiente local e preencha somente as
#  variáveis públicas permitidas no frontend.
#
#  O arquivo .env é ignorado pelo Git e nunca deve ser distribuído.
# =============================================================

# --- Backend (Supabase) --------------------------------------
# URL do projeto de backend.
VITE_PUBLIC_SUPABASE_URL=

# Chave publicável (client-side) do backend.
# Prefira esta chave em novos projetos.
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade temporária para projetos que ainda usam a chave anon legada.
# Preencha somente uma das duas chaves públicas acima/abaixo.
# VITE_PUBLIC_SUPABASE_ANON_KEY=

# Somente a URL e a chave publicável podem existir no navegador. Tokens de
# provedores devem ficar exclusivamente nos Secrets das Edge Functions.

# =============================================================
#  INTEGRAÇÕES FUTURAS (preencha apenas quando conectar)
#  Estes valores são segredos de backend e NÃO devem ficar
#  expostos no frontend. Configure-os no painel de Secrets
#  do backend quando necessário.
# =============================================================

# --- Resend (e-mail transacional) ----------------------------
# RESEND_API_KEY=
# RESEND_FROM_DOMAIN=

# --- Stripe (pagamentos) -------------------------------------
# STRIPE_SECRET_KEY=

# --- Shopify ------------------------------------------------
# ShopifyDomain=
# StorefrontAccessToken=
