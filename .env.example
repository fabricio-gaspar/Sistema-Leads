# Aplicação e Supabase
# Use a URL pública oficial. No Supabase, inclua também
# ${PUBLIC_SITE_URL}/reset-password em Authentication → URL Configuration.
PUBLIC_SITE_URL=https://seu-dominio.com.br
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA — configure pelo menos o provedor principal e, de preferência, um fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# WhatsApp — Z-API
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=

# E-mail transacional — Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OUTREACH_EMAIL_FROM=Ana <ana@seu-dominio.com.br>

# Instagram — Meta Graph API
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_API_VERSION=v23.0
# Obrigatório quando houver mais de uma empresa no mesmo banco
META_ORGANIZATION_ID=
# Opcional: lista separada por vírgulas dos hosts autorizados para download
# de anexos recebidos (ex.: cdn.exemplo.com,storage.z-api.io)
INBOUND_MEDIA_ALLOWED_HOSTS=

# Telefonia — adaptador HTTP genérico para o provedor VoIP escolhido
VOIP_PROVIDER=
VOIP_API_URL=
VOIP_API_TOKEN=

# Google Calendar por vendedor (conector Lovable/App User Connector)
GOOGLE_CALENDAR_APP_USER_CONNECTOR_CLIENT_API_KEY=
APP_USER_CONNECTION_KEY_SECRET=

# Prospecção
GOOGLE_PLACES_API_KEY=
CNPJWS_API_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=
NURTURE_ACTOR_ID=

# Workers protegidos
OUTREACH_CRON_SECRET=

# No GitHub Actions, cadastre também os repository secrets:
# AUTOMATION_BASE_URL=https://seu-dominio.com.br
# OUTREACH_CRON_SECRET=<o mesmo valor acima>
